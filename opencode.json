{
  "$schema": "https://opencode.ai/config.json",
  "share": "disabled",
  "compaction": {
    "auto": true,
    "prune": true,
    "reserved": 12000
  },
  "experimental": {
    "openTelemetry": false
  },
  "mcp": {
    "memory": {
      "type": "local",
      "command": [
        "/Users/andrewgibson/.local/share/fnm/node-versions/v24.14.0/installation/bin/mcp-server-memory"
      ],
      "env": {
        "MEMORY_FILE_PATH": "/Users/andrewgibson/.local/share/mcp-memory/memory.jsonl"
      },
      "enabled": true,
      "timeout": 3600000
    },
    "cgr-local": {
      "type": "local",
      "command": [
        "/Users/andrewgibson/.local/share/uv/tools/code-graph-rag/bin/cgr",
        "mcp-server"
      ],
      "env": {
        "MEMGRAPH_HOST": "localhost",
        "MEMGRAPH_PORT": "7689",
        "ORCHESTRATOR_PROVIDER": "openai",
        "ORCHESTRATOR_MODEL": "claude-sonnet-4-6",
        "ORCHESTRATOR_ENDPOINT": "https://api.nextgen-beta.ica.ibm.com/ica/v1",
        "ORCHESTRATOR_API_KEY": "REDACTED",
        "CYPHER_PROVIDER": "openai",
        "CYPHER_MODEL": "claude-sonnet-4-6",
        "CYPHER_ENDPOINT": "https://api.nextgen-beta.ica.ibm.com/ica/v1",
        "CYPHER_API_KEY": "REDACTED"
      },
      "enabled": true,
      "timeout": 600000
    },
    "kdb-local": {
      "type": "local",
      "command": [
        "/Users/andrewgibson/.local/share/fnm/node-versions/v24.14.0/installation/bin/mcp-local-rag"
      ],
      "env": {
        "DB_PATH": "/Users/andrewgibson/.local/share/mcp-knowledge",
        "MODEL_NAME": "Xenova/all-MiniLM-L6-v2",
        "CACHE_DIR": "/Users/andrewgibson/.cache/huggingface",
        "HF_HUB_OFFLINE": "0"
      },
      "enabled": true,
      "timeout": 3600000
    },
    "kdb-remote": {
      "type": "local",
      "command": [
        "/Users/andrewgibson/.local/share/kdb-remote/start-mcp-server.sh"
      ],
      "env": {
        "NODE_ENV": "development"
      },
      "enabled": true,
      "timeout": 3600000
    }
  },
