{
  "env": {
    "OPENCODE_YOLO": "true",
    "ANTHROPIC_AUTH_TOKEN": "${ANTHROPIC_AUTH_TOKEN}",
    "ANTHROPIC_DEFAULT_OPUS_MODEL": "glm-5.1",
    "ANTHROPIC_DEFAULT_SONNET_MODEL": "glm-5.1",
    "ANTHROPIC_BASE_URL": "https://api.z.ai/api/anthropic",
    "ANTHROPIC_API_KEY": "sk-dummy",
    "API_TIMEOUT_MS": "3000000",
    "DISABLE_NON_ESSENTIAL_MODEL_CALLS": "1",
    "CLAUDE_CODE_DISABLE_NONESSENTIAL_TRAFFIC": "1",
    "DISABLE_TELEMETRY": "1",
    "DISABLE_ERROR_REPORTING": "1",
    "CLAUDE_CODE_DISABLE_TERMINAL_TITLE": "1",
    "MAX_THINKING_TOKENS": "0"
  },
  "defaultMode": "default",
  "permissions": {
    "allow": [
      "Bash(wc:*)",
      "Bash(cat:*)",
      "Bash(du:*)",
      "Bash(grep:*)",
      "Bash(find:*)",
      "Bash(chmod:*)",
      "Bash(brew cleanup:*)",
      "Bash(numfmt:*)",
      "Bash(bc:*)",
      "Bash(xargs:*)",
      "Bash(docker:*)"
    ],
    "deny": [
      "Bash(rm -rf*)",
      "Bash(rm -fr*)",
      "Bash(git push --force*)",
      "Bash(git push -f*)",
      "Bash(git reset --hard*)",
      "Bash(git clean -fdx*)",
      "Bash(:(){ :|:& };:*)",
      "Bash(dd if=*)",
      "Bash(mkfs*)",
      "Bash(chmod -R 777*)",
      "Write(./.git/**)",
      "Edit(./.git/**)",
      "Write(./.claude/hooks/**)",
      "Edit(./.claude/hooks/**)",
      "Write(./.env*)",
      "Edit(./.env*)"
    ]
  },
  "includeCoAuthoredBy": false,
  "model": "opus",
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "bash ~/.claude/scripts/session-init.sh \"$PWD\""
          },
          {
            "type": "command",
            "command": "bash ~/.claude/scripts/generate-project-claude.sh \"$PWD\"",
            "timeout": 10000
          },
          {
            "type": "command",
            "command": "bash ~/.claude/scripts/detect-project.sh \"$PWD\"",
            "timeout": 5000
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "bash ~/.claude/hooks/user-prompt-tokens.sh"
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "bash ~/.claude/hooks/block-destructive.sh \"$ARGUMENTS\""
          },
          {
            "type": "command",
            "command": "bash ~/.claude/scripts/delegate-check.sh \"$ARGUMENTS\""
          }
        ]
      },
      {
        "matcher": "Write|Edit",
        "hooks": [
          {
            "type": "command",
            "command": "bash ~/.claude/hooks/scan-ai-attribution.sh"
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Write|Edit",
        "hooks": [
          {
            "type": "command",
            "command": "bash ~/.claude/hooks/auto-format.sh"
          }
        ]
      }
    ],
    "SessionEnd": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "bash ~/.claude/scripts/track-usage.sh --status"
          },
          {
            "type": "command",
            "command": "bash ~/.claude/scripts/context-summary.sh"
          },
          {
            "type": "command",
            "command": "bash ~/.claude/scripts/local-llm-usage.sh --end"
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "bash ~/.claude/hooks/post-response-tokens.sh --update"
          },
          {
            "type": "command",
            "command": "bash ~/.claude/scripts/context-summary.sh",
            "timeout": 5000
          }
        ]
      }
    ]
  },
  "enabledPlugins": {
    "everything-claude-code@everything-claude-code": true,
    "rust-analyzer-lsp@claude-plugins-official": true
  },
  "extraKnownMarketplaces": {
    "everything-claude-code": {
      "source": {
        "source": "github",
        "repo": "affaan-m/everything-claude-code"
      }
    }
  },
  "skipDangerousModePermissionPrompt": false
}
