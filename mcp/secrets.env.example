# MCP Server Secrets
# Copy this to secrets.env and fill in values.
# secrets.env is gitignored — never commit it.

# ICA / watsonx API key (used by cgr-local for Cypher generation)
ICA_API_KEY=<YOUR_ICA_API_KEY>

# ICA endpoint (default: IBM watsonx ICA beta)
ICA_ENDPOINT=https://api.nextgen-beta.ica.ibm.com/ica/v1

# kdb-remote: watsonx.ai
WATSONX_API_KEY=<YOUR_WATSONX_API_KEY>
WATSONX_PROJECT_ID=<YOUR_WATSONX_PROJECT_ID>
WATSONX_URL=<YOUR_WATSONX_URL>

# kdb-remote: IBM Cloud Redis
REDIS_HOST=<YOUR_REDIS_HOST>
REDIS_PORT=<YOUR_REDIS_PORT>
REDIS_PASSWORD=<YOUR_REDIS_PASSWORD>
REDIS_USERNAME=<YOUR_REDIS_USERNAME>
REDIS_TLS=true
REDIS_CA_CERT=<PATH_TO_CA_CERT>

# kdb-remote: server config
KDB_PORT=3001
KDB_NODE_ENV=production
KDB_EMBEDDING_MODEL=<MODEL_NAME>
KDB_EMBEDDING_DIMENSIONS=<DIMENSIONS>
